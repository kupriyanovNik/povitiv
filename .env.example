# ============ Уведомления о заявках ============
# Заявка всегда пишется в журнал на сервере (путь — LEADS_DIR ниже;
# дефолт data/leads затирается при обновлении сайта). Уведомление идёт только на
# почту. Без SMTP_HOST и LEAD_EMAIL_TO письмо не отправляется, заявка
# остаётся только в журнале.

# --- Email: ящик агентства positiv-vt@mail.ru
# SMTP_PASS — пароль для внешнего приложения (mail.ru: Настройки ->
# Безопасность -> Пароли для внешних приложений), не пароль от ящика.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=positiv-vt@mail.ru
SMTP_PASS=
LEAD_EMAIL_TO=positiv-vt@mail.ru
LEAD_EMAIL_FROM=positiv-vt@mail.ru

# --- Журнал заявок (каталог с правом записи, ВНЕ каталога сайта).
# Без LEADS_DIR журнал падает в data/leads ВНУТРИ каталога сайта и
# затирается при обновлении (HANDOFF.md, раздел 10). Впишите свой путь;
# на Windows Linux-путь не оставляйте — замените строку целиком:
#   Linux:   LEADS_DIR=/var/lib/positiv-vt/leads
#   Windows: LEADS_DIR=C:\sites\positiv-vt-data\leads
LEADS_DIR=/var/lib/positiv-vt/leads

# ============ Карта в подвале: JS API Яндекс Карт 3.0 ============
# Без ключа в подвале бесплатный виджет Яндекс Карт (может показывать
# стороннюю рекламу). С ключом — своя карта в палитре сайта с плашкой
# агентства (components/map/). Ключ бесплатный, оформляется на аккаунт
# заказчика: https://yandex.ru/maps-api/console -> «JavaScript API» ->
# «Бесплатный тариф». В ключе обязательно ограничение по HTTP Referer
# (positiv-vt.ru, *.positiv-vt.ru; для локальной проверки — localhost),
# иначе JS API 3.0 не работает. Активация до 15 минут.
# Читается при каждом запросе: после правки .env достаточно рестарта.
# Неверный ключ или чужой домен -> автоматически показывается виджет.
YANDEX_MAPS_API_KEY=
