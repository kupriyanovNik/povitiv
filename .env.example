# ============ Уведомления о заявках ============
# Заявка всегда сначала пишется в журнал на сервере (data/leads/*.jsonl,
# путь можно поменять через LEADS_DIR), затем рассылается по каналам ниже.
# Каждый канал включается, если заданы его переменные.
# Эти же каналы использует ночной синк для алертов о сбоях источников
# (scripts/sync-listings.mjs; проверка: node scripts/sync-listings.mjs --test-notify).

# --- Email (основной канал, российский SMTP: Яндекс 360, VK WorkSpace и т.п.)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# --- MAX-бот (вторичный канал)
# 1. В MAX найдите @MasterBot, команда /create, получите токен.
# 2. Менеджер пишет боту любое сообщение (Start).
# 3. chat_id смотрите через GET https://platform-api2.max.ru/updates
#    с заголовком Authorization: <токен>.
MAX_BOT_TOKEN=
MAX_CHAT_ID=

# --- Telegram (опция для не-РФ окружений; с VPS в РФ не работает)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_API_BASE=https://api.telegram.org

# --- Журнал заявок
# LEADS_DIR=/var/lib/positiv-vt/leads
