# ============ Уведомления о заявках ============
# Заявка всегда пишется в журнал на сервере (data/leads/*.jsonl,
# путь можно поменять через LEADS_DIR). Уведомление идёт только на
# почту; отправка пока не реализована (заглушка sendEmail в lib/leads.ts),
# переменные ниже понадобятся, когда её подключим.

# --- Email (российский SMTP: Яндекс 360, VK WorkSpace и т.п.)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# --- Журнал заявок
# LEADS_DIR=/var/lib/positiv-vt/leads

# ============ Карта в подвале: JS API Яндекс Карт 3.0 ============
# Без ключа в подвале бесплатный виджет Яндекс Карт (может показывать
# стороннюю рекламу). С ключом — своя карта в палитре сайта с плашкой
# агентства (components/map/). Ключ бесплатный, оформляется на аккаунт
# заказчика: https://yandex.ru/maps-api/console -> «JavaScript API» ->
# «Бесплатный тариф». В ключе обязательно ограничение по HTTP Referer
# (positiv-vt.ru, *.positiv-vt.ru; для локальной проверки — localhost),
# иначе JS API 3.0 не работает. Активация до 15 минут.
# Читается при каждом запросе: после правки .env достаточно рестарта.
# Неверный ключ или чужой домен -> автоматически показывается виджет.
YANDEX_MAPS_API_KEY=
