# ============ Уведомления о заявках ============
# Заявка всегда сначала пишется в журнал на сервере (data/leads/*.jsonl,
# путь можно поменять через LEADS_DIR), затем рассылается по каналам ниже.
# Каждый канал включается, если заданы его переменные.
# Эти же каналы использует ночной синк для алертов о сбоях источников
# (scripts/sync-listings.mjs; проверка: node scripts/sync-listings.mjs --test-notify).

# --- Email (основной канал, российский SMTP: Яндекс 360, VK WorkSpace и т.п.)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# --- MAX-бот (вторичный канал), подробно: deploy/README-VPS.md, «Бот MAX»
# Бота создаёт заказчик на business.max.ru (нужна верифицированная
# организация), токен берётся в настройках бота после модерации.
# Работает только на сервере с NODE_EXTRA_CA_CERTS (ниже); на демо
# в Vercel отправка в MAX падает, заявки идут остальными каналами.
MAX_BOT_TOKEN=
# коды чатов, куда приходят заявки, через запятую. Код сотрудник получает
# от бота по ссылке подключения (deploy/max-bot.sh check)
MAX_CHAT_ID=
# секрет вебхука и код ссылки подключения: deploy/max-bot.sh secret
MAX_WEBHOOK_SECRET=
MAX_CONNECT_CODE=
# Сертификат API MAX выпущен корневым центром Минцифры. Node доверяет ему
# только с этой переменной; systemd передаёт её сайту и синку из этого
# файла. Ставит администратор сервера, в репозитории сертификата нет.
# NODE_EXTRA_CA_CERTS=/etc/positiv-vt/russian_trusted_root_ca.pem

# --- Telegram (опция для не-РФ окружений; с VPS в РФ не работает)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_API_BASE=https://api.telegram.org

# --- Журнал заявок
# LEADS_DIR=/var/lib/positiv-vt/leads

# ============ ЦИАН API (официальный, public-api.cian.ru) ============
# Ключ агентство запрашивает в ЛК ЦИАН (Настройки -> Ещё -> ЦИАН API)
# или письмом на import@cian.ru с темой "ACCESS KEY". С ключом состав
# объявлений (что опубликовано/снято) синк берёт из API, а не парсингом;
# без ключа работает прежний парсинг страницы компании.
# Проверка ключа: npm run sync:test-api (локально) или
# node scripts/sync-listings.mjs --test-cian-api (на сервере, env из .env)
CIAN_API_KEY=

# ============ Карта в подвале: JS API Яндекс Карт 3.0 ============
# Без ключа в подвале бесплатный виджет Яндекс Карт (может показывать
# стороннюю рекламу). С ключом — своя карта в палитре сайта с плашкой
# агентства (components/map/). Ключ бесплатный, оформляется на аккаунт
# заказчика: https://yandex.ru/maps-api/console -> «JavaScript API» ->
# «Бесплатный тариф». В ключе обязательно ограничение по HTTP Referer
# (positiv-vt.ru, *.positiv-vt.ru; для локальной проверки — localhost),
# иначе JS API 3.0 не работает. Активация до 15 минут.
# Читается при каждом запросе: после правки .env достаточно рестарта.
# Неверный ключ или чужой домен -> автоматически показывается виджет.
YANDEX_MAPS_API_KEY=
