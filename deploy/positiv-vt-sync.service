# Разовый запуск синка данных: /etc/systemd/system/positiv-vt-sync.service
# Запускается таймером positiv-vt-sync.timer каждый день в 00:00 МСК.
[Unit]
Description=Positiv VT: sync listings from Cian and DomClick
After=network-online.target

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/positiv-vt
# для парсинга ЦИАН нужен браузер: apt install chromium,
# путь до бинарника передаётся скрипту через CHROME_BIN
Environment=NODE_ENV=production
Environment=CHROME_BIN=/usr/bin/chromium
# каналы алертов о сбоях синка (SMTP_*, MAX_*): те же, что у заявок;
# дефис — не падать, если файла ещё нет
EnvironmentFile=-/var/www/positiv-vt/.env
ExecStart=/usr/bin/node scripts/sync-listings.mjs
# рестарт сайта НЕ нужен: данные читаются с диска на каждый запрос,
# обновлённые JSON и фото подхватываются сразу
